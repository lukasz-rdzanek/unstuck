{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unstuck",
  // Custom entry point: wraps @astrojs/cloudflare/entrypoints/server with Sentry
  // (sentry.server.config.ts). No-op until the SENTRY_DSN secret is set.
  "main": "./sentry.server.config.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
