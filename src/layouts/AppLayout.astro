---
import Layout from "@/layouts/Layout.astro";
import AppTopbar from "@/components/AppTopbar.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<Layout title={title}>
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div class="bg-cosmic-starfield pointer-events-none absolute inset-0"></div>
    <div class="relative z-10 p-4 sm:p-8">
      <AppTopbar />
      <slot />
    </div>
  </div>
</Layout>
