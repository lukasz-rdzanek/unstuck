---
// Hardcoded-Tailwind cosmic topbar for landing/auth surfaces (Welcome, signin,
// signup). Sibling: src/components/AppTopbar.astro — token-driven variant used
// by in-app routes (catalog/course/lesson). Keep these two in sync when the
// cosmic system absorbs the landing as well.
import ThemeToggle from "@/components/ThemeToggle";
const { user } = Astro.locals;
---

<div
  class="border-glass bg-glass text-muted-foreground mb-4 flex items-center justify-between rounded-xl border px-4 py-2 text-sm"
>
  {
    user ? (
      <>
        <span class="text-muted-foreground">{user.email}</span>
        <div class="flex items-center gap-3">
          <ThemeToggle client:load />
          <a href="/dashboard" class="text-primary transition-colors hover:underline">
            Dashboard
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-primary transition-colors hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-muted-foreground">Not signed in</span>
        <div class="flex items-center gap-3">
          <ThemeToggle client:load />
          <a href="/auth/signin" class="text-primary transition-colors hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-primary transition-colors hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
