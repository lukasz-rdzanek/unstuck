---
// Token-driven cosmic topbar for in-app routes (catalog/course/lesson).
// Sibling: src/components/Topbar.astro — hardcoded-Tailwind variant kept for
// the landing/auth surfaces per Q4 ("tokenize new surfaces only"). Keep these
// two in sync when the cosmic system absorbs the landing as well.
// displayName is resolved by middleware once per request
// (Astro.locals.displayName) so we don't issue a duplicate profiles
// query here. We never render the raw email — privacy: avoid leaks
// during screen-sharing / demos.
import ThemeToggle from "@/components/ThemeToggle";
const { user, displayName } = Astro.locals;
---

<div
  class="border-border bg-card/50 text-foreground mb-4 flex items-center justify-between rounded-xl border px-4 py-2 text-sm backdrop-blur-xl"
>
  <a href="/" class="text-cosmic-gradient text-lg font-bold tracking-tight"> Unstuck </a>
  {
    user ? (
      <div class="flex items-center gap-3">
        <ThemeToggle client:load />
        <span class="text-muted-foreground">{displayName ?? "Learner"}</span>
        <a href="/dashboard" class="text-primary transition-opacity hover:opacity-80">
          Dashboard
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-primary transition-opacity hover:opacity-80">
            Sign out
          </button>
        </form>
      </div>
    ) : (
      <div class="flex items-center gap-3">
        <ThemeToggle client:load />
        <a href="/auth/signin" class="text-primary transition-opacity hover:opacity-80">
          Sign in
        </a>
        <a href="/auth/signup" class="text-primary transition-opacity hover:opacity-80">
          Sign up
        </a>
      </div>
    )
  }
</div>
