---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import { getLessonBySlugs, listChaptersWithLessonsForCourse } from "@/lib/services/courses";
import { getCompletedLessonIdsForCourse, isLessonCompletedByUser } from "@/lib/services/completions";
import { renderMarkdown } from "@/lib/markdown";
import { parseVideoUrl } from "@/lib/video-embed";
import LessonAside from "@/components/lesson/LessonAside";
import MarkCompleteButton from "@/components/lesson/MarkCompleteButton";

const { slug, lessonSlug } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const result = supabase && slug && lessonSlug ? await getLessonBySlugs(supabase, slug, lessonSlug) : null;

if (!result) {
  Astro.response.status = 404;
}

const lesson = result?.lesson;
const course = result?.course;
const html = lesson ? renderMarkdown(lesson.content_md) : "";
const video = lesson?.video_url ? parseVideoUrl(lesson.video_url) : null;
const pageTitle = lesson ? `${lesson.title} — Unstuck` : "Lesson not found — Unstuck";

// Resolve the signed-in user's display_name from profiles (per impl-review
// F3). Falls back to email-local-part only if no profile row exists, then
// to "Learner" — but the signup trigger guarantees a profile row, so the
// fallback rarely fires in practice. Surfacing the email prefix to all
// chat viewers would be a privacy regression.
let userDisplayName: string | null = null;
const userId = Astro.locals.user?.id ?? null;
if (supabase && userId) {
  const { data: profile } = await supabase.from("profiles").select("display_name").eq("id", userId).single();
  userDisplayName = profile?.display_name ?? Astro.locals.user?.email?.split("@")[0] ?? null;
}

// Run all three Supabase queries in parallel — they share no data
// dependency (all need course.id and userId only). Saves two
// Worker→Supabase round-trips on every lesson render vs sequential.
const [isCompleted, chapters, completedLessonIds] =
  supabase && userId && lesson && course
    ? await Promise.all([
        isLessonCompletedByUser(supabase, lesson.id, userId),
        listChaptersWithLessonsForCourse(supabase, course.id),
        getCompletedLessonIdsForCourse(supabase, course.id, userId),
      ])
    : [false, [], new Set<string>()];
---

<AppLayout title={pageTitle}>
  <div class="mx-auto max-w-6xl px-4 py-8 pb-24 lg:pb-8">
    {
      lesson && course ? (
        <>
          <a
            href={`/courses/${course.slug}`}
            class="text-primary mb-6 inline-block text-sm transition-opacity hover:opacity-80"
          >
            ← {course.title}
          </a>
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">
            <div class="min-w-0">
              {lesson.video_url !== null ? (
                <div class="bg-card/40 border-border relative mb-6 aspect-video w-full overflow-hidden rounded-2xl border backdrop-blur-xl">
                  {video?.embedSrc ? (
                    <iframe
                      src={video.embedSrc}
                      class="absolute inset-0 h-full w-full"
                      allowfullscreen
                      referrerpolicy="strict-origin"
                      loading="lazy"
                      sandbox="allow-scripts allow-same-origin allow-presentation"
                      allow="autoplay; fullscreen; picture-in-picture"
                      title={lesson.title}
                    />
                  ) : (
                    <div class="text-muted-foreground absolute inset-0 flex items-center justify-center p-8 text-center text-sm">
                      Video preview unavailable for this URL.
                    </div>
                  )}
                </div>
              ) : (
                <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-purple-400/30 bg-purple-400/10 px-3 py-1 text-xs font-medium tracking-wide text-purple-200 uppercase">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-3"
                  >
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                  </svg>
                  Reading
                </div>
              )}

              <h1 class="text-cosmic-gradient mb-6 text-3xl font-bold tracking-tight sm:text-4xl">{lesson.title}</h1>

              {/* eslint-disable-next-line astro/no-set-html-directive --
                  Operator-trusted markdown: lessons.INSERT/UPDATE reserved to
                  service_role by F-01 RLS. Trust boundary documented in
                  src/lib/markdown.ts. */}
              <article class="prose prose-invert max-w-none" set:html={html} />

              {userId && (
                <div class="mt-8 border-t border-white/10 pt-6">
                  <MarkCompleteButton client:load lessonId={lesson.id} initialCompleted={isCompleted} />
                </div>
              )}
            </div>

            <aside class="lg:sticky lg:top-8 lg:self-start">
              {/* Set → array → Set: completions service returns Set<string> for
                  O(1) `.has()` in course detail, but Set isn't JSON-serializable
                  across the Astro → React-island boundary. LessonsNav re-Set's
                  client-side (LessonsNav.tsx:29) for the same O(1) lookups. */}
              <LessonAside
                client:load
                lessonId={lesson.id}
                userId={userId}
                userDisplayName={userDisplayName}
                courseSlug={course.slug}
                chapters={chapters}
                completedLessonIds={Array.from(completedLessonIds)}
                currentLessonId={lesson.id}
              />
            </aside>
          </div>
        </>
      ) : (
        <div class="bg-card/40 border-border mx-auto max-w-3xl rounded-2xl border p-12 text-center backdrop-blur-xl">
          <h1 class="text-cosmic-gradient mb-4 text-3xl font-bold tracking-tight">Lesson not found</h1>
          <p class="text-muted-foreground mb-6">The lesson you're looking for doesn't exist or has been removed.</p>
          <a href="/courses" class="text-primary inline-block text-sm font-medium transition-opacity hover:opacity-80">
            ← Back to courses
          </a>
        </div>
      )
    }
  </div>
</AppLayout>
