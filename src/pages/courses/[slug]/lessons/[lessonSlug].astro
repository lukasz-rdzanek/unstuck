---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import { getLessonBySlugs, listChaptersWithLessonsForCourse } from "@/lib/services/courses";
import { listTestsForCourse } from "@/lib/services/tests";
import { getCompletedLessonIdsForCourse, isLessonCompletedByUser } from "@/lib/services/completions";
import { getCourseLastSeenAt, getCourseLatestUpdatedAt, upsertCourseView } from "@/lib/services/course-views";
import { renderMarkdown } from "@/lib/markdown";
import { parseVideoUrl } from "@/lib/video-embed";
import LessonAside from "@/components/lesson/LessonAside";
import LessonContentTabs from "@/components/lesson/LessonContentTabs.astro";
import LessonVideoPlayer from "@/components/lesson/LessonVideoPlayer";
import MarkCompleteButton from "@/components/lesson/MarkCompleteButton";
import SaveLessonButton from "@/components/lesson/SaveLessonButton";

const { slug, lessonSlug } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const result = supabase && slug && lessonSlug ? await getLessonBySlugs(supabase, slug, lessonSlug) : null;

if (!result) {
  Astro.response.status = 404;
}

const lesson = result?.lesson;
const course = result?.course;
const html = lesson ? renderMarkdown(lesson.content_md) : "";
// UNS-20: render the operator-authored autodescription when present; null,
// empty, or whitespace-only means "no summary" → no tab strip (lesson renders
// as before). .trim() collapses a whitespace-only value to the no-tab path.
const autoHtml = lesson?.autodescription_md?.trim() ? renderMarkdown(lesson.autodescription_md) : "";
const video = lesson?.video_url ? parseVideoUrl(lesson.video_url) : null;
const pageTitle = lesson ? `${lesson.title} — Unstuck` : "Lesson not found — Unstuck";

// Signed-in user identity (per impl-review F3 from S-06: no raw email
// to chat viewers — privacy). display_name is resolved by middleware
// once per request and exposed via Astro.locals.displayName.
const userId = Astro.locals.user?.id ?? null;
const userDisplayName = Astro.locals.displayName;

// Run all three Supabase queries in parallel — they share no data
// dependency (all need course.id and userId only). Saves two
// Worker→Supabase round-trips on every lesson render vs sequential.
const [isCompleted, chapters, completedLessonIds, lastSeenAt, courseUpdatedAt, courseTests] =
  supabase && userId && lesson && course
    ? await Promise.all([
        isLessonCompletedByUser(supabase, lesson.id, userId),
        listChaptersWithLessonsForCourse(supabase, course.id),
        getCompletedLessonIdsForCourse(supabase, course.id, userId),
        getCourseLastSeenAt(supabase, course.id, userId),
        getCourseLatestUpdatedAt(supabase, course.id),
        listTestsForCourse(supabase, course.id),
      ])
    : [false, [], new Set<string>(), null, null, []];

// Slim test shape for the lesson-nav (chapter "boss" rows + final test).
const navTests = courseTests.map((t) => ({ chapterId: t.chapter_id, slug: t.slug, title: t.title }));

// UNS-14 (c): record this visit so the next render's lastSeenAt
// reflects today. Awaited (~50ms) so the upsert lands before the
// next visit could observe stale state. Errors are logged in the
// service, not thrown — visit-recording failures should not block
// the lesson render.
if (supabase && userId && course) {
  await upsertCourseView(supabase, course.id, userId);
}

// 1.F: prev/next nav + "Lesson N of M" badge — derived from chapters
// (already loaded above; zero new queries). Flatten chapter→lesson tree
// in chapter.position then lesson.position order (the service returns
// them ordered). currentIndex === -1 falls back to back-only behaviour.
const allLessons = lesson && course ? chapters.flatMap((ch) => ch.lessons) : [];
const currentIndex = lesson ? allLessons.findIndex((l) => l.id === lesson.id) : -1;
const totalLessons = allLessons.length;
const prevLesson = currentIndex > 0 ? allLessons[currentIndex - 1] : null;
const nextLesson = currentIndex >= 0 && currentIndex < totalLessons - 1 ? allLessons[currentIndex + 1] : null;
---

<AppLayout title={pageTitle}>
  <div class="mx-auto max-w-6xl px-4 py-8 pb-24 lg:pb-8">
    {
      lesson && course ? (
        <>
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_360px] [&:has([data-aside-collapsed='true'])]:lg:grid-cols-1">
            <div class="min-w-0">
              <div class="mb-6 flex items-center justify-between gap-3">
                <a href={`/courses/${course.slug}`} class="text-primary text-sm transition-opacity hover:opacity-80">
                  ← {course.title}
                </a>
                {currentIndex !== -1 && (prevLesson ?? nextLesson) ? (
                  <nav class="flex items-center gap-2" aria-label="Lesson navigation">
                    {prevLesson ? (
                      <a
                        href={`/courses/${course.slug}/lessons/${prevLesson.slug}`}
                        class="border-info/30 bg-info/10 text-info hover:bg-info/20 inline-flex size-9 items-center justify-center rounded-xl border backdrop-blur-xl transition-colors"
                        aria-label={`Previous lesson: ${prevLesson.title}`}
                        title={`Previous: ${prevLesson.title}`}
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-4"
                          aria-hidden="true"
                        >
                          <path d="m15 18-6-6 6-6" />
                        </svg>
                      </a>
                    ) : null}
                    {nextLesson ? (
                      <a
                        href={`/courses/${course.slug}/lessons/${nextLesson.slug}`}
                        class="border-info/30 bg-info/10 text-info hover:bg-info/20 inline-flex size-9 items-center justify-center rounded-xl border backdrop-blur-xl transition-colors"
                        aria-label={`Next lesson: ${nextLesson.title}`}
                        title={`Next: ${nextLesson.title}`}
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-4"
                          aria-hidden="true"
                        >
                          <path d="m9 18 6-6-6-6" />
                        </svg>
                      </a>
                    ) : null}
                  </nav>
                ) : null}
              </div>
              {lesson.video_url !== null ? (
                video && video.provider !== "unknown" && video.id ? (
                  <LessonVideoPlayer client:load provider={video.provider} videoId={video.id} title={lesson.title} />
                ) : (
                  <div class="bg-card/40 border-border relative mb-6 aspect-video w-full overflow-hidden rounded-2xl border backdrop-blur-xl">
                    <div class="text-muted-foreground absolute inset-0 flex items-center justify-center p-8 text-center text-sm">
                      Video preview unavailable for this URL.
                    </div>
                  </div>
                )
              ) : (
                <div class="border-primary/30 bg-primary/10 text-primary mb-6 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium tracking-wide uppercase">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-3"
                  >
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                  </svg>
                  Reading
                </div>
              )}

              {currentIndex !== -1 && totalLessons > 0 && (
                <div class="border-info/30 bg-info/10 text-info mb-3 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium tracking-wide uppercase">
                  <span class="font-mono">{currentIndex + 1}</span>
                  <span class="text-info/60">/</span>
                  <span class="font-mono">{totalLessons}</span>
                  <span class="ml-0.5">Lesson</span>
                </div>
              )}

              <h1 class="text-cosmic-gradient mb-6 text-3xl font-bold tracking-tight sm:text-4xl">{lesson.title}</h1>

              {autoHtml ? (
                <LessonContentTabs contentHtml={html} autodescriptionHtml={autoHtml} />
              ) : (
                /* eslint-disable-next-line astro/no-set-html-directive --
                    Operator-trusted markdown: lessons.INSERT/UPDATE reserved to
                    service_role by F-01 RLS. Trust boundary documented in
                    src/lib/markdown.ts. */
                <article class="prose max-w-none" set:html={html} />
              )}

              {userId && (
                <div class="border-border mt-8 flex flex-wrap items-center gap-3 border-t pt-6">
                  <MarkCompleteButton client:load lessonId={lesson.id} initialCompleted={isCompleted} />
                  <SaveLessonButton
                    client:load
                    title={lesson.title}
                    courseTitle={course.title}
                    contentMd={lesson.content_md}
                    videoUrl={lesson.video_url}
                    courseSlug={course.slug}
                    lessonSlug={lesson.slug}
                  />
                </div>
              )}
            </div>

            <aside class="lg:sticky lg:top-8 lg:self-start">
              {/* Set → array → Set: completions service returns Set<string> for
                  O(1) `.has()` in course detail, but Set isn't JSON-serializable
                  across the Astro → React-island boundary. LessonsNav re-Set's
                  client-side (LessonsNav.tsx:29) for the same O(1) lookups. */}
              <LessonAside
                client:load
                courseId={course.id}
                lessonId={lesson.id}
                userId={userId}
                userDisplayName={userDisplayName}
                courseSlug={course.slug}
                chapters={chapters}
                completedLessonIds={Array.from(completedLessonIds)}
                currentLessonId={lesson.id}
                tests={navTests}
                courseUpdatedAt={courseUpdatedAt ? courseUpdatedAt.toISOString() : null}
                lastSeenAt={lastSeenAt ? lastSeenAt.toISOString() : null}
              />
            </aside>
          </div>
        </>
      ) : (
        <div class="bg-card/40 border-border mx-auto max-w-3xl rounded-2xl border p-12 text-center backdrop-blur-xl">
          <h1 class="text-cosmic-gradient mb-4 text-3xl font-bold tracking-tight">Lesson not found</h1>
          <p class="text-muted-foreground mb-6">The lesson you're looking for doesn't exist or has been removed.</p>
          <a href="/courses" class="text-primary inline-block text-sm font-medium transition-opacity hover:opacity-80">
            ← Back to courses
          </a>
        </div>
      )
    }
  </div>
</AppLayout>
