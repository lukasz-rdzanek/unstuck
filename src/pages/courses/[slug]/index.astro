---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import { getCourseBySlug, listChaptersWithLessonsForCourse } from "@/lib/services/courses";
import { getCompletedLessonIdsForCourse } from "@/lib/services/completions";

const { slug } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const course = supabase && slug ? await getCourseBySlug(supabase, slug) : null;

if (!course) {
  Astro.response.status = 404;
}

const userId = Astro.locals.user?.id ?? null;
const isSignedIn = userId !== null;
// Run both queries in parallel — they share no data dependency, both
// only need course.id and (for completions) userId. Saves one Worker→
// Supabase round-trip on every course detail render.
const [chapters, completedLessonIds] = await Promise.all([
  course && supabase ? listChaptersWithLessonsForCourse(supabase, course.id) : Promise.resolve([]),
  isSignedIn && supabase && course && userId
    ? getCompletedLessonIdsForCourse(supabase, course.id, userId)
    : Promise.resolve(new Set<string>()),
]);
const pageTitle = course ? `${course.title} — Unstuck` : "Course not found — Unstuck";
---

<AppLayout title={pageTitle}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    {
      course ? (
        <>
          <header class="mb-10">
            <a href="/courses" class="text-primary mb-4 inline-block text-sm transition-opacity hover:opacity-80">
              ← All courses
            </a>
            <h1 class="text-cosmic-gradient mb-4 text-4xl font-bold tracking-tight sm:text-5xl">{course.title}</h1>
            {course.description && <p class="text-muted-foreground text-lg leading-relaxed">{course.description}</p>}
          </header>

          {chapters.length === 0 ? (
            <div class="bg-card/40 border-border rounded-2xl border p-8 text-center backdrop-blur-xl">
              <p class="text-muted-foreground">No chapters in this course yet.</p>
            </div>
          ) : (
            <div class="space-y-8">
              {chapters.map((chapter) => (
                <section>
                  <h2 class="text-foreground mb-4 text-lg font-semibold">
                    <span class="text-muted-foreground mr-2 font-mono text-sm">
                      {String(chapter.position).padStart(2, "0")}
                    </span>
                    {chapter.title}
                  </h2>
                  {isSignedIn ? (
                    chapter.lessons.length === 0 ? (
                      <p class="text-muted-foreground bg-card/40 border-border rounded-xl border p-4 text-sm backdrop-blur-xl">
                        No lessons in this chapter yet.
                      </p>
                    ) : (
                      <ol class="space-y-3">
                        {chapter.lessons.map((lesson) => {
                          const done = completedLessonIds.has(lesson.id);
                          return (
                            <li>
                              <a
                                href={`/courses/${course.slug}/lessons/${lesson.slug}`}
                                class="bg-card/40 border-border hover:bg-card/60 flex items-center gap-4 rounded-xl border p-4 backdrop-blur-xl transition-colors"
                              >
                                {done ? (
                                  <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="text-success size-4"
                                    aria-label="Completed"
                                  >
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                    <path d="m9 11 3 3L22 4" />
                                  </svg>
                                ) : (
                                  <span class="text-muted-foreground font-mono text-sm">
                                    {String(lesson.position).padStart(2, "0")}
                                  </span>
                                )}
                                <span
                                  class:list={done ? "text-foreground/60 font-medium" : "text-foreground font-medium"}
                                >
                                  {lesson.title}
                                </span>
                                {lesson.video_url === null ? (
                                  <span class="text-muted-foreground ml-auto text-xs tracking-wide uppercase">
                                    Reading
                                  </span>
                                ) : null}
                              </a>
                            </li>
                          );
                        })}
                      </ol>
                    )
                  ) : null}
                </section>
              ))}

              {!isSignedIn ? (
                <div class="bg-card/40 border-border rounded-2xl border p-8 text-center backdrop-blur-xl">
                  <p class="text-muted-foreground mb-6">Sign in to view the lessons in this course.</p>
                  <a
                    href={`/auth/signin?next=/courses/${course.slug}`}
                    class="shadow-cosmic-glow bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium transition-colors"
                  >
                    Sign in to view lessons
                  </a>
                </div>
              ) : null}
            </div>
          )}
        </>
      ) : (
        <div class="bg-card/40 border-border rounded-2xl border p-12 text-center backdrop-blur-xl">
          <h1 class="text-cosmic-gradient mb-4 text-3xl font-bold tracking-tight">Course not found</h1>
          <p class="text-muted-foreground mb-6">The course you're looking for doesn't exist or has been removed.</p>
          <a href="/courses" class="text-primary inline-block text-sm font-medium transition-opacity hover:opacity-80">
            ← Back to courses
          </a>
        </div>
      )
    }
  </div>
</AppLayout>
