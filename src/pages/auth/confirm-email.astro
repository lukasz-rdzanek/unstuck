---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle";

const emailParam = Astro.url.searchParams.get("email") ?? "";
const errorParam = Astro.url.searchParams.get("error");

const errorCopy: Record<string, string> = {
  invalid_otp: "That code didn't match. Double-check and try again.",
  otp_expired: "Your code expired. Request a new one below.",
  format_invalid: "The code is digits only — re-enter it exactly as in the email.",
  email_invalid: "Enter a valid email address.",
  supabase_not_configured: "Server is misconfigured — contact the operator.",
};
const errorMessage = errorParam ? (errorCopy[errorParam] ?? "Couldn't verify. Try again or request a new code.") : null;
---

<Layout title="Confirm your email">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <ThemeToggle floating client:load />
    <div
      class="border-glass bg-glass text-foreground w-full max-w-sm rounded-2xl border p-8 text-center backdrop-blur-xl"
    >
      <div class="mb-4 text-5xl">📧</div>
      <h1 class="text-cosmic-gradient mb-3 text-2xl font-bold">Confirm your email</h1>
      <p class="text-muted-foreground mb-5 text-sm">
        We sent a code to your inbox. Enter it below to activate your account.
      </p>

      {
        errorMessage && (
          <div class="border-destructive/30 bg-destructive/10 text-destructive mb-4 rounded-lg border p-3 text-sm">
            {errorMessage}
          </div>
        )
      }

      <form method="POST" action="/api/auth/verify-otp" class="space-y-3 text-left">
        <div>
          <label for="email" class="text-muted-foreground mb-1 block text-xs font-medium">Email</label>
          <input
            id="email"
            type="email"
            name="email"
            value={emailParam}
            readonly={emailParam !== ""}
            required
            class="border-input bg-glass text-foreground placeholder:text-muted-foreground focus:border-ring w-full rounded-md border px-3 py-2 text-sm read-only:cursor-not-allowed read-only:opacity-70 focus:outline-none"
            placeholder="you@example.com"
          />
        </div>

        <div>
          <label for="token" class="text-muted-foreground mb-1 block text-xs font-medium">Confirmation code</label>
          {
            /* Accept 6–10 digits: Supabase's auth.email.otp_length is local-only and the
              cloud project may issue a longer code than the local stack. Keep this range in
              lockstep with the regex on src/pages/api/auth/verify-otp.ts. */
          }
          <input
            id="token"
            type="text"
            name="token"
            inputmode="numeric"
            pattern="\d{6,10}"
            maxlength="10"
            autocomplete="one-time-code"
            required
            class="border-input bg-glass text-foreground placeholder:text-muted-foreground focus:border-ring w-full rounded-md border px-3 py-2 text-center font-mono text-lg tracking-[0.4em] focus:outline-none"
            placeholder="Code from email"
          />
        </div>

        <button
          type="submit"
          class="bg-primary text-primary-foreground hover:bg-primary/90 w-full rounded-md px-4 py-2 text-sm font-medium transition"
        >
          Confirm and sign in
        </button>
      </form>

      <div class="border-border text-muted-foreground mt-6 border-t pt-4 text-xs">
        <p class="mb-2">Didn&apos;t get the code?</p>
        <form id="resend-form" method="POST" action="/api/auth/resend" class="flex items-center justify-center gap-2">
          <input type="hidden" name="email" value={emailParam} />
          <button
            id="resend-button"
            type="submit"
            class="bg-glass text-foreground hover:bg-muted rounded-md px-3 py-1.5 text-xs transition disabled:cursor-not-allowed disabled:opacity-50"
          >
            Resend code
          </button>
        </form>
        <p id="resend-status" class="text-muted-foreground mt-2 hidden"></p>
      </div>

      <p class="text-muted-foreground mt-5 text-xs">
        <a href="/auth/signin" class="text-primary hover:underline">Back to sign in</a>
      </p>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById("resend-form") as HTMLFormElement | null;
  const button = document.getElementById("resend-button") as HTMLButtonElement | null;
  const status = document.getElementById("resend-status") as HTMLParagraphElement | null;
  if (form && button && status) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.classList.remove("hidden");
      status.textContent = "Sending…";
      try {
        const body = new FormData(form);
        const res = await fetch("/api/auth/resend", { method: "POST", body });
        if (res.status === 200) {
          status.textContent = "Code sent — check your inbox.";
        } else if (res.status === 429) {
          const data = (await res.json().catch(() => ({}))) as { retryAfterSeconds?: number };
          const wait = data.retryAfterSeconds ?? 60;
          status.textContent = `Please wait about ${wait}s before requesting again.`;
        } else if (res.status === 400) {
          const data = (await res.json().catch(() => ({}))) as { error?: string };
          status.textContent = data.error ?? "Couldn't request a new code.";
        } else {
          status.textContent = "Couldn't request a new code right now.";
        }
      } catch {
        status.textContent = "Network error — try again in a moment.";
      } finally {
        // Re-enable after a short cooldown so accidental double-clicks don't spam.
        setTimeout(() => {
          button.disabled = false;
        }, 5000);
      }
    });
  }
</script>
