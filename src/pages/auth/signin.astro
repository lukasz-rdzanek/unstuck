---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import ThemeToggle from "@/components/ThemeToggle";

const error = Astro.url.searchParams.get("error");
const next = Astro.url.searchParams.get("next");
const unconfirmedEmail = Astro.url.searchParams.get("unconfirmed_email");
---

<Layout title="Sign in">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <ThemeToggle floating client:load />
    <div class="border-glass bg-glass text-foreground w-full max-w-sm rounded-2xl border p-8 backdrop-blur-xl">
      <h1 class="text-cosmic-gradient mb-6 text-center text-2xl font-bold">Sign in</h1>
      <SignInForm serverError={error} next={next} unconfirmedEmail={unconfirmedEmail} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Don't have an account? <a href="/auth/signup" class="text-primary hover:underline">Sign up</a>
      </p>
    </div>
  </div>
</Layout>
