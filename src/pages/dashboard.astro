---
import AppLayout from "@/layouts/AppLayout.astro";

const { user } = Astro.locals;
---

<AppLayout title="Dashboard">
  <div
    class="border-glass bg-glass text-foreground mx-auto mt-12 max-w-md rounded-2xl border p-8 text-center backdrop-blur-xl"
  >
    <h1 class="text-cosmic-gradient mb-4 text-3xl font-bold">Dashboard</h1>
    <p class="text-muted-foreground">
      Welcome, <span class="text-foreground font-semibold">{user?.email}</span>
    </p>
    <p class="text-muted-foreground mt-2 text-sm">This page is only for authenticated users.</p>
    <form method="POST" action="/api/auth/signout" class="mt-6">
      <button
        type="submit"
        class="border-border bg-glass hover:bg-muted rounded-lg border px-4 py-2 text-sm transition-colors"
      >
        Sign out
      </button>
    </form>
  </div>
</AppLayout>
