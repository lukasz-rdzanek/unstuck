+"use client";
+
+import { useState } from "react";
+
+export function BookmarkButton({ lessonId, userId }: { lessonId: string; userId: string }) {
+  const [saved, setSaved] = useState(false);
+
+  async function save() {
+    await fetch("/api/bookmarks", {
+      method: "POST",
+      body: JSON.stringify({ lessonId, userId }),
+    });
+    setSaved(true);
+  }
+
+  return (
+    <button onClick={save} className={"px-2 " + (saved ? "text-green-500" : "text-gray-500")}>
+      {saved ? "Saved" : "Save"}
+    </button>
+  );
+}
