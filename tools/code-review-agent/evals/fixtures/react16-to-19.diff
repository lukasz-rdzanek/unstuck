+      .then((r) => r.json())
+      .then((d) => setNotes(d.notes));
+  });
+
+  // FLAW 2: fire-and-forget PUT, no await/error handling; marks saved even on failure.
+  function save() {
+    fetch(`/api/notes/${lessonId}`, { method: "PUT", body: notes });
+    setSaved(true);
+  }
+
